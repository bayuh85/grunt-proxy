# Upstream OpenAI-compatible API.
# Chat completions: {GRUNT_UPSTREAM_BASE_URL}/chat/completions
# Anthropic messages: https://atmorouter.dev/v1/messages when the base is the default.
# The Anthropic SDK and Claude Code append /v1/messages themselves, so their
# base URL is the proxy origin (no /v1). OpenAI clients include /v1.
GRUNT_UPSTREAM_BASE_URL=https://atmorouter.dev/v1

# If set, this key is sent upstream and the client key is ignored.
# AtmoRouter keys look like ar-...
# Leave empty to forward the incoming Authorization or x-api-key header.
GRUNT_API_KEY=

# Also accepted as a key override: ATMOROUTER_API_KEY
# Used only when no override is set and the client sent no key:
# OPENAI_API_KEY
# ANTHROPIC_API_KEY

# Listen address. Localhost by default so the proxy is not a public credit sink.
GRUNT_HOST=127.0.0.1
GRUNT_PORT=8642

# 0 off, 1 filler only, 2 articles + short forms (default), 3 heavier and lossier
GRUNT_LEVEL=2

# auto | always | off
# auto adds the terse-reply instruction only on larger prompts
GRUNT_TERSE=auto

# Optional JSONL ledger. `grunt-proxy --report` reprints a savings report from it.
# GRUNT_LOG_FILE=.grunt-savings.jsonl

# USD per 1M tokens. Unset = built-in table matched on the model id.
# Set these to your real AtmoRouter rate so estimated savings match the bill.
# GRUNT_PRICE_IN=3
# GRUNT_PRICE_OUT=15

# Projected output reduction (0 through 0.9) used only as a labeled estimate.
# Default 0: dollars reflect input-token delta only. Terse replies are still requested.
# GRUNT_ASSUME_OUTPUT_CUT=0

# Upstream request timeout in milliseconds. 0 waits without a proxy-side limit.
# GRUNT_TIMEOUT_MS=0

# Max request body. Default 33554432 (32 MiB).
# GRUNT_MAX_BODY_BYTES=33554432
